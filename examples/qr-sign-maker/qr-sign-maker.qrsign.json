    "base_height_mm": 10,
    "base_front_mm": 10,
    "base_back_mm": 58.5,
    "text_above": "Make your own|QR Code",
    "text_above_scales": "0.4|1",
    "text_below": "by Jonathan Hunt",
    "text_below_scales": "",
    "font": "Rockwell Extra Bold",
    "border_mm": 5,
    "corner_radius_mm": 2.5,
    "qr_fraction": 0.62,
    "base_qr": 1,
    "base_qr_url": "github.com/ecodad/laser-cut-qr-sign-maker",
    "base_qr_text": "",
    "base_qr_size_mm": 30,
    "base_qr_text_mm": 2.8,
    "angle_deg": null,
    "base_width_mm": null,
    "base_angle_deg": null,
    "slot_clearance_mm": null,
    "gap_mm": null,
    "line_spacing": null,
    "merge_qr": null,
    "cut_stroke_mm": null,
    "piece_spacing_mm": null
