{
  "format": "qrsign-project",
  "version": 2,
  "name": "qr-sign-maker",
  "url": "https://github.com/ecodad/laser-cut-qr-sign-maker",
  "style": {
    "body": "smooth",
    "eye_frame": "leaf",
    "eye_ball": "square",
    "logo_path": "",
    "logo_shape": "square",
    "logo_size": 0.25,
    "logo_clear": true
  },
  "sign": {
    "width_mm": 80,
    "height_mm": 150,
    "thickness_mm": 3,
