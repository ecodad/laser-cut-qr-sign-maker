  "print": {
    "mode": "multi",
    "layer_height": 0.2,
    "back_mm": 2.0,
    "qr_layers": 5,
    "text_layers": 3,
    "flip": false,
    "color_background": "#F5F0E6",
    "color_qr": "#111111",
    "color_text": "#B0262B",
    "base_lean_deg": 10.0,
    "base_depth_mm": 40.0,
    "base_height_mm": 14.0,
    "base_wall_mm": 3.0,
    "slot_depth_mm": 10.0,
